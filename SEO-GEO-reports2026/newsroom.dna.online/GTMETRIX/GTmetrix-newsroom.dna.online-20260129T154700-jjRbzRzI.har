                  "mimeType" : "application/javascript",
                  "size" : 1280,
                  "text" : "// DNA\nvar CompaniesCustom6 = {};\n\n$(document).ready(function () {\n \n  CompaniesCustom6.login();\n\n\n  $(\".seeMoreBtn\").attr(\"href\", \"\");\n  $(\".driveCompanyAdministratorsStepsContainer\").hide();\n  $(\"#driveCompanyAdministratorsIssuesContainer\").hide();\n  if (window.location.href.includes(\"view-contacts\")) {\n    MoonDrive.setTrainingLink(\"\");\n  }\n\n  if($('#companyMainLogo').length > 0){\n    setTimeout(function () {\n      $('#companyMainLogo').attr('src', LayoutsCompanies.company.logo.url);\n    }, 1000);  \n  }\n\n\n});\n\nCompaniesCustom6.login = function () {\n    let confidentialityStatement = 'Welcome to the DNA media centre. Sign up or log in to download stories & media.';\n    let signUpDataInfo = \"DNA would like to send you alerts when new stories are published so you can hear about new stories and access content as soon as it is available. To make sure you receive alerts of interest to you, please select the relevant news categories above.\";\n    $('#confidentialityStatement label').html(confidentialityStatement);... [truncated to save space (256 more bytes)]"
